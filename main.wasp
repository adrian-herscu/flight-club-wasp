app OpenSaaS {
  wasp: { version: "^0.21.0" },

  title: "Flight Club",

  head: [
    "<link rel='icon' href='/favicon.svg' />",

    "<meta name='description' content='Your apps main description and features.' />",
    "<meta name='author' content='Your (App) Name' />",
    "<meta name='keywords' content='saas, solution, product, app, service' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='Your Open SaaS App' />",
    "<meta property='og:site_name' content='Your Open SaaS App' />",
    "<meta property='og:url' content='https://your-saas-app.com' />",
    "<meta property='og:description' content='Your apps main description and features.' />",
    "<meta property='og:image' content='https://your-saas-app.com/public-banner.webp' />",
    "<meta name='twitter:image' content='https://your-saas-app.com/public-banner.webp' />",
    "<meta name='twitter:image:width' content='800' />",
    "<meta name='twitter:image:height' content='400' />",
    "<meta name='twitter:card' content='summary_large_image' />",
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.js'></script>",
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.local.js'></script>",
  ],

  auth: {
    userEntity: User,
    methods: {
      email: {
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
        fromField: {
          name: "Flight Club",
          email: "hello@flightclub.app"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute
        },
        passwordReset: {
          clientRoute: PasswordResetRoute
        }
      },
      google: {
        userSignupFields: import { getGoogleUserFields } from "@src/auth/userSignupFields",
        configFn: import { getGoogleAuthConfig } from "@src/auth/userSignupFields"
      }
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  },

  emailSender: {
    provider: SendGrid
  },

  db: {
    seeds: [
      import { seedMockUsers } from "@src/server/scripts/dbSeeds"
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App"
  }
}

//#region Auth Pages
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}
route LandingPageRoute { path: "/", to: LandingPage }

query getLandingSchoolsWithCourses {
  fn: import { getLandingSchoolsWithCourses } from "@src/landing-page/operations",
  entities: [School, Syllabus, SyllabusVersion, Course, CourseLifecycleEvent]
}

page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}
route LoginRoute { path: "/login", to: LoginPage }

page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}
route SignupRoute { path: "/signup", to: SignupPage }

page EmailVerificationPage {
  component: import { EmailVerification } from "@src/auth/EmailVerificationPage"
}
route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }

page RequestPasswordResetPage {
  component: import { RequestPasswordReset } from "@src/auth/RequestPasswordResetPage"
}
route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }

page PasswordResetPage {
  component: import { PasswordReset } from "@src/auth/PasswordResetPage"
}
route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
//#endregion

//#region Registration
page RegistrationPage {
  authRequired: true,
  component: import RegistrationPage from "@src/registration/RegistrationPage"
}
route RegistrationRoute { path: "/registration", to: RegistrationPage }

query getMyRegistrationRequests {
  fn: import { getMyRegistrationRequests } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision]
}

query getRegistrationSchoolOptions {
  fn: import { getRegistrationSchoolOptions } from "@src/registration/operations",
  entities: [School]
}

action submitRegistrationRequest {
  fn: import { submitRegistrationRequest } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest]
}

page AdminSchoolRequestsPage {
  authRequired: true,
  component: import AdminSchoolRequestsPage from "@src/admin/dashboards/school-requests/SchoolRequestsDashboardPage"
}
route AdminSchoolRequestsRoute { path: "/system-admin/school-requests", to: AdminSchoolRequestsPage }

query getPendingSchoolManagerRequests {
  fn: import { getPendingSchoolManagerRequests } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest]
}

action approveSchoolManagerRequest {
  fn: import { approveSchoolManagerRequest } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision, UserSchoolRole, Account]
}

action rejectSchoolManagerRequest {
  fn: import { rejectSchoolManagerRequest } from "@src/registration/operations",
  entities: [User, RegistrationRequest, RegistrationRequestDecision]
}

page SchoolManagerInstructorRequestsPage {
  authRequired: true,
  component: import ManagerRequestsPage from "@src/school-manager/ManagerRequestsDashboardPage"
}
route ManagerInstructorRequestsRoute { path: "/school-manager/member-requests/instructors", to: SchoolManagerInstructorRequestsPage }

page SchoolManagerStudentRequestsPage {
  authRequired: true,
  component: import ManagerRequestsPage from "@src/school-manager/ManagerRequestsDashboardPage"
}
route ManagerStudentRequestsRoute { path: "/school-manager/member-requests/students", to: SchoolManagerStudentRequestsPage }

query getPendingSchoolMemberRequests {
  fn: import { getPendingSchoolMemberRequests } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest]
}

action approveSchoolMemberRequest {
  fn: import { approveSchoolMemberRequest } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision, UserSchoolRole, Instructor, Student, Account]
}

action rejectSchoolMemberRequest {
  fn: import { rejectSchoolMemberRequest } from "@src/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision]
}
//#endregion

//#region User
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}
route AccountRoute { path: "/account", to: AccountPage }

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/user/operations",
  entities: [User]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/user/operations",
  entities: [User]
}

action updateMyUserProfile {
  fn: import { updateMyUserProfile } from "@src/user/operations",
  entities: [User]
}
//#endregion

//#region School Manager
page SchoolManagerSchoolPage {
  authRequired: true,
  component: import ManagerSchoolPage from "@src/school-manager/ManagerSchoolPage"
}
route ManagerSchoolRoute { path: "/school-manager/school", to: SchoolManagerSchoolPage }

page SchoolManagerSyllabusesPage {
  authRequired: true,
  component: import ManagerSyllabusesPage from "@src/school-manager/ManagerSyllabusesPage"
}
route ManagerSyllabusesRoute { path: "/school-manager/syllabuses", to: SchoolManagerSyllabusesPage }

page SchoolManagerCoursesPage {
  authRequired: true,
  component: import ManagerCoursesPage from "@src/school-manager/ManagerCoursesPage"
}
route ManagerCoursesRoute { path: "/school-manager/courses", to: SchoolManagerCoursesPage }

query getMyManagedSchool {
  fn: import { getMyManagedSchool } from "@src/school-manager/operations",
  entities: [User, School, Account]
}

query getManagerSyllabusCatalog {
  fn: import { getManagerSyllabusCatalog } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, HiddenSyllabusDraft]
}

query getSyllabusVersionDetails {
  fn: import { getSyllabusVersionDetails } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, HiddenSyllabusDraft]
}

action createDraftSyllabusFromScratch {
  fn: import { createDraftSyllabusFromScratch } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action createDraftSyllabusFromTemplate {
  fn: import { createDraftSyllabusFromTemplate } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action saveDraftSyllabusRevision {
  fn: import { saveDraftSyllabusRevision } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action publishDraftSyllabusVersion {
  fn: import { publishDraftSyllabusVersion } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action deleteDraftSyllabusVersion {
  fn: import { deleteDraftSyllabusVersion } from "@src/school-manager/syllabusDraftDeleteOperations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, Course, HiddenSyllabusDraft]
}

action deleteAllEditableDraftSyllabusVersions {
  fn: import { deleteAllEditableDraftSyllabusVersions } from "@src/school-manager/syllabusDraftDeleteOperations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, Course, HiddenSyllabusDraft]
}

action createCourseFromFinalSyllabus {
  fn: import { createCourseFromFinalSyllabus } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course]
}

query getManagerCoursesForEnrollment {
  fn: import { getManagerCoursesForEnrollment } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, EnrolledStudent, CourseLifecycleEvent]
}

query getManagerClosedCourses {
  fn: import { getManagerClosedCourses } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, EnrolledStudent, CourseLifecycleEvent]
}

query getManagerStudentsForEnrollment {
  fn: import { getManagerStudentsForEnrollment } from "@src/school-manager/operations",
  entities: [User, School, Student, Account]
}

query getManagerCourseEnrollmentDetails {
  fn: import { getManagerCourseEnrollmentDetails } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Student, EnrolledStudent]
}

query getManagerInstructorsForAssignment {
  fn: import { getManagerInstructorsForAssignment } from "@src/school-manager/operations",
  entities: [User, School, Instructor, Account]
}

query getManagerCourseInstructorDetails {
  fn: import { getManagerCourseInstructorDetails } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Instructor, AssignedInstructor]
}

action enrollStudentInCourse {
  fn: import { enrollStudentInCourse } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Student, EnrolledStudent, Account, CourseLifecycleEvent]
}

action assignInstructorToCourse {
  fn: import { assignInstructorToCourse } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Instructor, AssignedInstructor, Account, CourseLifecycleEvent]
}

action closeCourse {
  fn: import { closeCourse } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseLifecycleEvent]
}

action reopenCourse {
  fn: import { reopenCourse } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseLifecycleEvent]
}

action updateMyManagedSchool {
  fn: import { updateMyManagedSchool } from "@src/school-manager/updateSchoolOperations",
  entities: [User, School, Account]
}

query getManagerCourseInterests {
  fn: import { getManagerCourseInterests } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest]
}

action advanceCourseInterestToContacted {
  fn: import { advanceCourseInterestToContacted } from "@src/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest]
}
//#endregion

//#region Student Portal
action expressInterestInCourse {
  fn: import { expressInterestInCourse } from "@src/portal/student/operations",
  entities: [User, Course, CourseInterest]
}

query getMyInterests {
  fn: import { getMyInterests } from "@src/portal/student/operations",
  entities: [User, Course, CourseInterest, Syllabus, SyllabusVersion, School]
}
//#endregion

//#region Admin Dashboard
page SystemAdminDashboardPage {
  authRequired: true,
  component: import AdminDashboard from "@src/admin/dashboards/analytics/AnalyticsDashboardPage"
}
route SystemAdminRoute { path: "/system-admin", to: SystemAdminDashboardPage }

page SchoolManagerDashboardPage {
  authRequired: true,
  component: import AdminDashboard from "@src/admin/dashboards/analytics/AnalyticsDashboardPage"
}
route SchoolManagerRoute { path: "/school-manager", to: SchoolManagerDashboardPage }

page InstructorDashboardPage {
  authRequired: true,
  component: import InstructorDashboardPage from "@src/portal/instructor/DashboardPage"
}
route InstructorRoute { path: "/instructor", to: InstructorDashboardPage }

page StudentDashboardPage {
  authRequired: true,
  component: import StudentDashboardPage from "@src/portal/student/DashboardPage"
}
route StudentRoute { path: "/student", to: StudentDashboardPage }

page SystemAdminUsersPage {
  authRequired: true,
  component: import AdminUsers from "@src/admin/dashboards/users/UsersDashboardPage"
}
route SystemAdminUsersRoute { path: "/system-admin/users", to: SystemAdminUsersPage }

page SystemAdminSettingsPage {
  authRequired: true,
  component: import AdminSettings from "@src/admin/elements/settings/SettingsPage"
}
route SystemAdminSettingsRoute { path: "/system-admin/settings", to: SystemAdminSettingsPage }

page SystemAdminSyllabusesPage {
  authRequired: true,
  component: import ManagerSyllabusesPage from "@src/school-manager/ManagerSyllabusesPage"
}
route SystemAdminSyllabusesRoute { path: "/system-admin/syllabuses", to: SystemAdminSyllabusesPage }

page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
route NotFoundRoute { path: "*", to: NotFoundPage }
//#endregion

//#region Contact Form Messages
page SystemAdminMessagesPage {
  authRequired: true,
  component: import AdminMessages from "@src/admin/dashboards/messages/MessagesPage"
}
route SystemAdminMessagesRoute { path: "/system-admin/messages", to: SystemAdminMessagesPage }
//#endregion
