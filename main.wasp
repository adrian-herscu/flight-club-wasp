app OpenSaaS {
  wasp: { version: "^0.21.0" },

  title: "Flight Club",

  head: [
    "<link rel='icon' href='/favicon.svg' />",

    "<meta name='description' content='Your apps main description and features.' />",
    "<meta name='author' content='Your (App) Name' />",
    "<meta name='keywords' content='saas, solution, product, app, service' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='Your Open SaaS App' />",
    "<meta property='og:site_name' content='Your Open SaaS App' />",
    "<meta property='og:url' content='https://your-saas-app.com' />",
    "<meta property='og:description' content='Your apps main description and features.' />",
    "<meta property='og:image' content='https://your-saas-app.com/public-banner.webp' />",
    "<meta name='twitter:image' content='https://your-saas-app.com/public-banner.webp' />",
    "<meta name='twitter:image:width' content='800' />",
    "<meta name='twitter:image:height' content='400' />",
    "<meta name='twitter:card' content='summary_large_image' />",
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.js'></script>",
    "<script defer data-domain='<your-site-id>' src='https://plausible.io/js/script.local.js'></script>",
  ],

  auth: {
    userEntity: User,
    methods: {
      email: {
        userSignupFields: import { getEmailUserFields } from "@src/areas/auth/userSignupFields",
        fromField: {
          name: "Flight Club",
          email: "hello@flightclub.app"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute
        },
        passwordReset: {
          clientRoute: PasswordResetRoute
        }
      },
      google: {
        userSignupFields: import { getGoogleUserFields } from "@src/areas/auth/userSignupFields",
        configFn: import { getGoogleAuthConfig } from "@src/areas/auth/userSignupFields"
      }
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  },

  emailSender: {
    provider: SendGrid
  },

  db: {
    seeds: [
      import { seedMockUsers } from "@src/server/scripts/dbSeeds"
    ]
  },

  client: {
    rootComponent: import App from "@src/client/App"
  }
}

//#region Auth Pages
page LandingPage {
  component: import LandingPage from "@src/areas/public/landing/LandingPage"
}
route LandingPageRoute { path: "/", to: LandingPage }

query getLandingSchoolsWithCourses {
  fn: import { getLandingSchoolsWithCourses } from "@src/areas/public/landing/operations",
  entities: [School, User, UserSchoolRole, Syllabus, SyllabusVersion, Course, AssignedInstructor, Instructor, CourseLifecycleEvent, CourseInterest]
}

query getDevSeedUsers {
  fn: import { getDevSeedUsers } from "@src/areas/auth/operations",
  entities: [User]
}

page LoginPage {
  component: import Login from "@src/areas/auth/LoginPage"
}
route LoginRoute { path: "/login", to: LoginPage }

page SignupPage {
  component: import { Signup } from "@src/areas/auth/SignupPage"
}
route SignupRoute { path: "/signup", to: SignupPage }

page EmailVerificationPage {
  component: import { EmailVerification } from "@src/areas/auth/EmailVerificationPage"
}
route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }

page RequestPasswordResetPage {
  component: import { RequestPasswordReset } from "@src/areas/auth/RequestPasswordResetPage"
}
route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }

page PasswordResetPage {
  component: import { PasswordReset } from "@src/areas/auth/PasswordResetPage"
}
route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
//#endregion

//#region Registration
page RegistrationPage {
  authRequired: true,
  component: import RegistrationPage from "@src/areas/account/registration/RegistrationPage"
}
route RegistrationRoute { path: "/registration", to: RegistrationPage }

query getMyRegistrationRequests {
  fn: import { getMyRegistrationRequests } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision]
}

query getRegistrationSchoolOptions {
  fn: import { getRegistrationSchoolOptions } from "@src/areas/account/registration/operations",
  entities: [School]
}

action submitRegistrationRequest {
  fn: import { submitRegistrationRequest } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest]
}

page AdminSchoolRequestsPage {
  authRequired: true,
  component: import AdminSchoolRequestsPage from "@src/areas/system-admin/dashboards/school-requests/SchoolRequestsDashboardPage"
}
route AdminSchoolRequestsRoute { path: "/system-admin/school-requests", to: AdminSchoolRequestsPage }

query getPendingSchoolManagerRequests {
  fn: import { getPendingSchoolManagerRequests } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest]
}

action approveSchoolManagerRequest {
  fn: import { approveSchoolManagerRequest } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision, UserSchoolRole, Account]
}

action rejectSchoolManagerRequest {
  fn: import { rejectSchoolManagerRequest } from "@src/areas/account/registration/operations",
  entities: [User, RegistrationRequest, RegistrationRequestDecision]
}

page SchoolManagerInstructorRequestsPage {
  authRequired: true,
  component: import ManagerRequestsPage from "@src/areas/school-manager/ManagerRequestsDashboardPage"
}
route ManagerInstructorRequestsRoute { path: "/school-manager/member-requests/instructors", to: SchoolManagerInstructorRequestsPage }

page SchoolManagerStudentRequestsPage {
  authRequired: true,
  component: import ManagerRequestsPage from "@src/areas/school-manager/ManagerRequestsDashboardPage"
}
route ManagerStudentRequestsRoute { path: "/school-manager/member-requests/students", to: SchoolManagerStudentRequestsPage }

query getPendingSchoolMemberRequests {
  fn: import { getPendingSchoolMemberRequests } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest]
}

action approveSchoolMemberRequest {
  fn: import { approveSchoolMemberRequest } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision, UserSchoolRole, Instructor, Student, Account]
}

action rejectSchoolMemberRequest {
  fn: import { rejectSchoolMemberRequest } from "@src/areas/account/registration/operations",
  entities: [User, School, RegistrationRequest, RegistrationRequestDecision]
}
//#endregion

//#region User
page AccountPage {
  authRequired: true,
  component: import Account from "@src/areas/account/profile/AccountPage"
}
route AccountRoute { path: "/account", to: AccountPage }

query getPaginatedUsers {
  fn: import { getPaginatedUsers } from "@src/areas/account/profile/operations",
  entities: [User]
}

action updateIsUserAdminById {
  fn: import { updateIsUserAdminById } from "@src/areas/account/profile/operations",
  entities: [User]
}

action updateMyUserProfile {
  fn: import { updateMyUserProfile } from "@src/areas/account/profile/operations",
  entities: [User]
}

query getMyDashboardPath {
  fn: import { getMyDashboardPath } from "@src/areas/account/profile/operations",
  entities: [User, UserSchoolRole]
}
//#endregion

//#region School Manager
page SchoolManagerSchoolPage {
  authRequired: true,
  component: import ManagerSchoolPage from "@src/areas/school-manager/ManagerSchoolPage"
}
route ManagerSchoolRoute { path: "/school-manager/school", to: SchoolManagerSchoolPage }

page SchoolManagerSyllabusesPage {
  authRequired: true,
  component: import ManagerSyllabusesPage from "@src/areas/school-manager/ManagerSyllabusesPage"
}
route ManagerSyllabusesRoute { path: "/school-manager/syllabuses", to: SchoolManagerSyllabusesPage }

page SchoolManagerCoursesPage {
  authRequired: true,
  component: import ManagerCoursesPage from "@src/areas/school-manager/ManagerCoursesPage"
}
route ManagerCoursesRoute { path: "/school-manager/courses", to: SchoolManagerCoursesPage }

query getMyManagedSchool {
  fn: import { getMyManagedSchool } from "@src/areas/school-manager/operations",
  entities: [User, School, Account]
}

query getManagerSyllabusCatalog {
  fn: import { getManagerSyllabusCatalog } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, HiddenSyllabusDraft]
}

query getSyllabusVersionDetails {
  fn: import { getSyllabusVersionDetails } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, HiddenSyllabusDraft]
}

action createDraftSyllabusFromScratch {
  fn: import { createDraftSyllabusFromScratch } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action createDraftSyllabusFromTemplate {
  fn: import { createDraftSyllabusFromTemplate } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action saveDraftSyllabusRevision {
  fn: import { saveDraftSyllabusRevision } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action publishDraftSyllabusVersion {
  fn: import { publishDraftSyllabusVersion } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson]
}

action deleteDraftSyllabusVersion {
  fn: import { deleteDraftSyllabusVersion } from "@src/areas/school-manager/syllabusDraftDeleteOperations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, Course, HiddenSyllabusDraft]
}

action deleteAllEditableDraftSyllabusVersions {
  fn: import { deleteAllEditableDraftSyllabusVersions } from "@src/areas/school-manager/syllabusDraftDeleteOperations",
  entities: [User, School, Syllabus, SyllabusVersion, SyllabusLesson, Course, HiddenSyllabusDraft]
}

action createCourseFromFinalSyllabus {
  fn: import { createCourseFromFinalSyllabus } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course]
}

query getManagerCoursesForEnrollment {
  fn: import { getManagerCoursesForEnrollment } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, EnrolledStudent, CourseLifecycleEvent]
}

query getManagerClosedCourses {
  fn: import { getManagerClosedCourses } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, EnrolledStudent, CourseLifecycleEvent]
}

query getManagerStudentsForEnrollment {
  fn: import { getManagerStudentsForEnrollment } from "@src/areas/school-manager/operations",
  entities: [User, School, Student, Account]
}

query getManagerCourseEnrollmentDetails {
  fn: import { getManagerCourseEnrollmentDetails } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Student, EnrolledStudent]
}

query getManagerInstructorsForAssignment {
  fn: import { getManagerInstructorsForAssignment } from "@src/areas/school-manager/operations",
  entities: [User, School, Instructor, Account]
}

query getManagerCourseInstructorDetails {
  fn: import { getManagerCourseInstructorDetails } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Instructor, AssignedInstructor]
}

action enrollStudentInCourse {
  fn: import { enrollStudentInCourse } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Student, EnrolledStudent, Account, CourseLifecycleEvent]
}

action assignInstructorToCourse {
  fn: import { assignInstructorToCourse } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, Instructor, AssignedInstructor, Account, CourseLifecycleEvent]
}

action closeCourse {
  fn: import { closeCourse } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseLifecycleEvent]
}

action startCourse {
  fn: import { startCourse } from "@src/course-execution/operations",
  entities: [User, School, Course, AssignedInstructor, EnrolledStudent, CourseLifecycleEvent]
}

action scheduleLesson {
  fn: import { scheduleLesson } from "@src/course-execution/operations",
  entities: [User, Course, SyllabusLesson, CourseLesson, AssignedInstructor, EnrolledStudent, Instructor, MeetingAttendance, InstructorLessonPresence]
}

action rescheduleLesson {
  fn: import { rescheduleLesson } from "@src/course-execution/operations",
  entities: [User, Course, SyllabusLesson, CourseLesson, AssignedInstructor, Instructor, MeetingAttendance, InstructorLessonPresence, InstructorSuggestion]
}

action updateMeetingAttendance {
  fn: import { updateMeetingAttendance } from "@src/course-execution/operations",
  entities: [User, CourseLesson, Student, EnrolledStudent, MeetingAttendance]
}

action submitInstructorSuggestion {
  fn: import { submitInstructorSuggestion } from "@src/course-execution/operations",
  entities: [User, CourseLesson, Instructor, AssignedInstructor, MeetingAttendance, InstructorSuggestion]
}

action approveInstructorSuggestion {
  fn: import { approveInstructorSuggestion } from "@src/course-execution/operations",
  entities: [User, School, Course, CourseLesson, InstructorSuggestion, CourseLifecycleEvent]
}

action updateInstructorPresence {
  fn: import { updateInstructorPresence } from "@src/course-execution/operations",
  entities: [User, CourseLesson, Instructor, AssignedInstructor, InstructorLessonPresence]
}

action markInstructorAbsent {
  fn: import { markInstructorAbsent } from "@src/course-execution/operations",
  entities: [User, CourseLesson, Instructor, AssignedInstructor, InstructorLessonPresence]
}

action submitStudentAssessment {
  fn: import { submitStudentAssessment } from "@src/course-execution/operations",
  entities: [User, Course, CourseLesson, SyllabusLesson, Instructor, AssignedInstructor, Student, EnrolledStudent, StudentLessonEvaluation, InstructorLessonPresence, Account, Transaction, CourseLifecycleEvent, School]
}

action enrollInStartedCourse {
  fn: import { enrollInStartedCourse } from "@src/course-execution/operations",
  entities: [User, School, Course, Student, EnrolledStudent, CourseLesson, MeetingAttendance, Account, Transaction, SyllabusLesson]
}

action submitRefundRequest {
  fn: import { submitRefundRequest } from "@src/course-execution/operations",
  entities: [User, Course, Student, EnrolledStudent, RefundRequest, CourseLifecycleEvent]
}

action approveRefund {
  fn: import { approveRefund } from "@src/course-execution/operations",
  entities: [User, School, Course, Student, RefundRequest, Account, Transaction]
}

action declineRefund {
  fn: import { declineRefund } from "@src/course-execution/operations",
  entities: [User, School, Course, RefundRequest]
}

query getCourseDetail {
  fn: import { getCourseDetail } from "@src/course-execution/operations",
  entities: [User, UserSchoolRole, School, Course, CourseLesson, SyllabusLesson, SyllabusVersion, Syllabus, CourseLifecycleEvent, Instructor, AssignedInstructor, Student, EnrolledStudent]
}

job lessonStatusJob {
  executor: PgBoss,
  perform: {
    fn: import { lessonStatusJobHandler } from "@src/course-execution/lessonStatusJob"
  },
  schedule: {
    cron: "* * * * *"
  },
  entities: [CourseLesson, Course, MeetingAttendance]
}

action reopenCourse {
  fn: import { reopenCourse } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseLifecycleEvent]
}

action updateMyManagedSchool {
  fn: import { updateMyManagedSchool } from "@src/areas/school-manager/updateSchoolOperations",
  entities: [User, School, Account]
}

query getManagerCourseInterests {
  fn: import { getManagerCourseInterests } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest]
}

query getManagerStudentCoursePairs {
  fn: import { getManagerStudentCoursePairs } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest]
}

action cancelCourseInterestForManager {
  fn: import { cancelCourseInterestForManager } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest]
}

action approveStudentEnrollmentFromInterest {
  fn: import { approveStudentEnrollmentFromInterest } from "@src/areas/school-manager/operations",
  entities: [User, School, Syllabus, SyllabusVersion, Course, CourseInterest, RegistrationRequest, RegistrationRequestDecision, UserSchoolRole, Student, Account, EnrolledStudent, CourseLifecycleEvent]
}
//#endregion

//#region Student Portal
action expressInterestInCourse {
  fn: import { expressInterestInCourse } from "@src/areas/student/operations",
  entities: [User, Course, CourseInterest]
}

action cancelMyCourseInterest {
  fn: import { cancelMyCourseInterest } from "@src/areas/student/operations",
  entities: [User, CourseInterest]
}

query getMyInterests {
  fn: import { getMyInterests } from "@src/areas/student/operations",
  entities: [User, Course, CourseInterest, Syllabus, SyllabusVersion, School]
}

query getStudentSchools {
  fn: import { getStudentSchools } from "@src/areas/student/operations",
  entities: [User, School, UserSchoolRole]
}

query getStudentEnrolledCourses {
  fn: import { getStudentEnrolledCourses } from "@src/areas/student/operations",
  entities: [User, School, UserSchoolRole, Student, Course, EnrolledStudent, SyllabusVersion, Syllabus]
}
//#endregion

//#region Admin Dashboard
//#region Instructor Portal
query getInstructorSchools {
  fn: import { getInstructorSchools } from "@src/areas/instructor/operations",
  entities: [User, School, UserSchoolRole]
}

query getInstructorAssignedCourses {
  fn: import { getInstructorAssignedCourses } from "@src/areas/instructor/operations",
  entities: [User, School, UserSchoolRole, Instructor, Course, SyllabusVersion, Syllabus, AssignedInstructor, CourseLifecycleEvent]
}
//#endregion

//#region Admin Dashboard
page SystemAdminDashboardPage {
  authRequired: true,
  component: import AdminDashboard from "@src/areas/system-admin/dashboards/analytics/AnalyticsDashboardPage"
}
route SystemAdminRoute { path: "/system-admin", to: SystemAdminDashboardPage }

page SchoolManagerDashboardPage {
  authRequired: true,
  component: import SchoolManagerDashboardPage from "@src/areas/school-manager/dashboard/DashboardPage"
}
route SchoolManagerRoute { path: "/school-manager", to: SchoolManagerDashboardPage }

page InstructorDashboardPage {
  authRequired: true,
  component: import InstructorDashboardPage from "@src/areas/instructor/DashboardPage"
}
route InstructorRoute { path: "/instructor", to: InstructorDashboardPage }

page InstructorCoursesPage {
  authRequired: true,
  component: import InstructorCoursesPage from "@src/areas/instructor/InstructorCoursesPage"
}
route InstructorCoursesRoute { path: "/instructor/courses", to: InstructorCoursesPage }

page StudentDashboardPage {
  authRequired: true,
  component: import StudentDashboardPage from "@src/areas/student/DashboardPage"
}
route StudentRoute { path: "/student", to: StudentDashboardPage }

page StudentCoursesPage {
  authRequired: true,
  component: import StudentCoursesPage from "@src/areas/student/StudentCoursesPage"
}
route StudentCoursesRoute { path: "/student/courses", to: StudentCoursesPage }

page InstructorCourseDetailPage {
  authRequired: true,
  component: import CourseDetailPage from "@src/course-execution/CourseDetailPage"
}
route InstructorCourseDetailRoute { path: "/instructor/courses/:courseId", to: InstructorCourseDetailPage }

page StudentCourseDetailPage {
  authRequired: true,
  component: import CourseDetailPage from "@src/course-execution/CourseDetailPage"
}
route StudentCourseDetailRoute { path: "/student/courses/:courseId", to: StudentCourseDetailPage }

page ManagerCourseDetailPage {
  authRequired: true,
  component: import CourseDetailPage from "@src/course-execution/CourseDetailPage"
}
route ManagerCourseDetailRoute { path: "/school-manager/courses/:courseId", to: ManagerCourseDetailPage }

page SystemAdminUsersPage {
  authRequired: true,
  component: import AdminUsers from "@src/areas/system-admin/dashboards/users/UsersDashboardPage"
}
route SystemAdminUsersRoute { path: "/system-admin/users", to: SystemAdminUsersPage }

page SystemAdminSettingsPage {
  authRequired: true,
  component: import AdminSettings from "@src/areas/system-admin/elements/settings/SettingsPage"
}
route SystemAdminSettingsRoute { path: "/system-admin/settings", to: SystemAdminSettingsPage }

page SystemAdminSyllabusesPage {
  authRequired: true,
  component: import ManagerSyllabusesPage from "@src/areas/school-manager/ManagerSyllabusesPage"
}
route SystemAdminSyllabusesRoute { path: "/system-admin/syllabuses", to: SystemAdminSyllabusesPage }

page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
route NotFoundRoute { path: "*", to: NotFoundPage }
//#endregion

//#region Contact Form Messages
page SystemAdminMessagesPage {
  authRequired: true,
  component: import AdminMessages from "@src/areas/system-admin/dashboards/messages/MessagesPage"
}
route SystemAdminMessagesRoute { path: "/system-admin/messages", to: SystemAdminMessagesPage }
//#endregion
