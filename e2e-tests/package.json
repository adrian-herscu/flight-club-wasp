{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "e2e-tests for opensaas.sh",
  "author": "",
  "license": "ISC",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "db:reset": "cd ../app && wasp db reset --force",
    "wasp:kill": "fuser -k 3000/tcp 3001/tcp || true",
    "wasp:restart": "npm run wasp:kill && npm run db:reset && cd ../app && wasp start | tee wasp-dev.log",
    "e2e:regression": "npx playwright test",
    "e2e:smoke": "npx playwright test --project=chromium --grep @smoke --reporter=html,github",
    "e2e:regression:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@playwright/test": "^1.42.1",
    "@prisma/client": "5.19.1",
    "prisma": "5.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0"
  }
}
