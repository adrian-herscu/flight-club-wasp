{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "e2e-tests for opensaas.sh",
  "author": "",
  "license": "ISC",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "wasp:kill": "fuser -k 3000/tcp 3001/tcp || true",
    "wasp:clean": "rm -rf ../app/.wasp",
    "wasp:db:reset": "cd ../app && wasp db reset --force",
    
    "wasp:lint": "cd ../app && npm run lint:ui-boundary",
    "wasp:build": "cd ../app && wasp build",
  
    "wasp:start": "cd ../app && wasp start",
    "wasp:restart": "npm run wasp:kill && npm run wasp:clean && npm run wasp:lint && npm run wasp:db:reset && npm run wasp:start",

    "e2e:regression": "npx playwright test",
    "e2e:smoke": "npx playwright test --project=chromium --grep @smoke --reporter=html,github",
    "e2e:regression:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@playwright/test": "^1.42.1",
    "@prisma/client": "5.19.1",
    "prisma": "5.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0"
  }
}
