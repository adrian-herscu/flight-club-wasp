{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "yaml.schemas": {
    "docs/ui-model.schema.json": "docs/ui-model.yml"
  },
  "prisma.fileWatcher.enable": true,
  "prisma.schemaPath": "schema.prisma",
  "files.exclude": {
    ".wasp/out/**/schema.prisma": true,
    "node_modules/**/.prisma/client/schema.prisma": true
  },
  "search.exclude": {
    ".wasp/**": true,
    "node_modules/**": true
  }
}
