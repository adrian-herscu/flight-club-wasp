datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyllabusVersionStatus {
  DRAFT
  FINAL
  OBSOLETE
}


enum RegistrationRequestRole {
  SCHOOL_MANAGER
  INSTRUCTOR
  STUDENT
}

enum SchoolRole {
  SCHOOL_MANAGER
  INSTRUCTOR
  STUDENT
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationRequestDecisionType {
  APPROVED
  REJECTED
}

enum LessonEvaluationStatus {
  PASS
  FAIL
}

enum CourseInterestStatus {
  INTERESTED
  ENROLLED
  CANCELLED
}

enum CourseLifecycleStatus {
  CLOSED
  REOPENED
  STARTED
  COMPLETED
}

enum CourseLessonStatus {
  SCHEDULED
  BELOW_CAPACITY
  CONFIRMED
  LESSON_UNDERWAY
  LESSON_CONCLUDED
  CANCELLED
}

enum MeetingAttendanceStatus {
  NO_RESPONSE
  ACCEPTED
  DECLINED
}

enum InstructorSuggestionType {
  PROCEED_WITH_PARTIAL
  CLOSE_COURSE
}

enum InstructorSuggestionStatus {
  PENDING
  APPROVED
  SUPERSEDED
}

enum InstructorLessonPresenceStatus {
  EXPECTED
  DECLINED
  ABSENT
}

enum EnrolledStudentStatus {
  ACTIVE
  CERTIFIED
  FAILED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

model School {
  id                        String          @id @default(uuid())
  name                      String
  websiteUrl                String?
  logoUrl                   String?
  addressLine1              String
  addressLine2              String?
  city                      String
  stateProvince             String?
  postalCode                String
  country                   String          // ISO 3166-1 alpha-2 country code (e.g., US, GB, FR)
  currency                  String          // ISO 4217 currency code (e.g., USD, GBP, EUR)
  defaultHourlyRate         Int?            // Default course hourly rate in whole currency units
  createdAt                 DateTime        @default(now())
  
  admin                     User            @relation("SchoolAdmin", fields: [adminId], references: [id])
  adminId                   String
  syllabuses                Syllabus[]
  accounts                  Account[]
  memberRegistrationRequests RegistrationRequest[] @relation("RegistrationTargetSchool")
  approvedManagerRequests   RegistrationRequest[] @relation("RegistrationApprovedSchool")
  schoolRoles               UserSchoolRole[] @relation("SchoolRoleMembership")
  approvedRegistrationDecisions RegistrationRequestDecision[] @relation("RegistrationDecisionApprovedSchool")
  courses                   Course[]
  
  @@unique([name, country])
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String          @unique
  fullName                  String?
  phone                     String?

  isSystemAdmin             Boolean         @default(false)

  subscriptionStatus        SubscriptionStatus?
  subscriptionPlan          String?
  sendNewsletter            Boolean         @default(false)
  datePaid                  DateTime?
  credits                   Int             @default(0)
  paymentProcessorUserId    String?
  lemonSqueezyCustomerPortalUrl String?

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
  adminOfSchools            School[]        @relation("SchoolAdmin")
  instructorProfile         Instructor?
  studentProfile            Student?
  courseInterests           CourseInterest[]
  accounts                  Account[]
  registrationRequests      RegistrationRequest[] @relation("RegistrationRequester")
  reviewedRegistrationRequests RegistrationRequest[] @relation("RegistrationReviewer")
  schoolRoles               UserSchoolRole[]      @relation("UserSchoolRoleMembership")
  grantedSchoolRoles        UserSchoolRole[]      @relation("UserSchoolRoleGrantedBy")
  reviewedRegistrationDecisions RegistrationRequestDecision[] @relation("RegistrationDecisionReviewer")
  hiddenSyllabusDrafts                HiddenSyllabusDraft[]      @relation("HiddenSyllabusDraftDeletedBy")
  courseLifecycleEvents               CourseLifecycleEvent[]     @relation("CourseLifecycleChangedBy")
  proposedLessons                     CourseLesson[]             @relation("CourseLessonProposedBy")
  reviewedInstructorSuggestions       InstructorSuggestion[]     @relation("InstructorSuggestionReviewedBy")
  reviewedRefundRequests              RefundRequest[]            @relation("RefundRequestReviewedBy")
}

model RegistrationRequest {
  id                        String                   @id @default(uuid())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  requester                 User                     @relation("RegistrationRequester", fields: [requesterId], references: [id])
  requesterId               String

  requestedRole             RegistrationRequestRole
  status                    RegistrationRequestStatus @default(PENDING)

  targetSchool              School?                  @relation("RegistrationTargetSchool", fields: [targetSchoolId], references: [id])
  targetSchoolId            String?

  requestedSchoolName       String?
  requestedWebsiteUrl       String?
  requestedLogoUrl          String?
  requestedAddressLine1     String?
  requestedAddressLine2     String?
  requestedCity             String?
  requestedStateProvince    String?
  requestedPostalCode       String?
  requestedCountry          String?
  requestedCurrency         String?

  reviewer                  User?                    @relation("RegistrationReviewer", fields: [reviewerId], references: [id])
  reviewerId                String?
  reviewedAt                DateTime?
  rejectionReason           String?

  approvedSchool            School?                  @relation("RegistrationApprovedSchool", fields: [approvedSchoolId], references: [id])
  approvedSchoolId          String?
  decisions                 RegistrationRequestDecision[]
  grantedSchoolRoles        UserSchoolRole[]

  @@index([status, requestedRole, createdAt])
  @@index([requesterId, createdAt])
  @@index([targetSchoolId, status, createdAt])
}

model UserSchoolRole {
  id                        String               @id @default(uuid())
  createdAt                 DateTime             @default(now())
  grantedAt                 DateTime             @default(now())
  revokedAt                 DateTime?

  user                      User                 @relation("UserSchoolRoleMembership", fields: [userId], references: [id])
  userId                    String

  school                    School               @relation("SchoolRoleMembership", fields: [schoolId], references: [id])
  schoolId                  String

  role                      SchoolRole

  grantedByUser             User?                @relation("UserSchoolRoleGrantedBy", fields: [grantedByUserId], references: [id])
  grantedByUserId           String?

  sourceRegistrationRequest RegistrationRequest? @relation(fields: [sourceRegistrationRequestId], references: [id])
  sourceRegistrationRequestId String?

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
  @@index([userId, role])
}

model RegistrationRequestDecision {
  id                        String                          @id @default(uuid())
  createdAt                 DateTime                        @default(now())
  decisionType              RegistrationRequestDecisionType
  reason                    String?

  request                   RegistrationRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId                 String                          @unique

  reviewer                  User?                           @relation("RegistrationDecisionReviewer", fields: [reviewerId], references: [id])
  reviewerId                String?

  approvedSchool            School?                         @relation("RegistrationDecisionApprovedSchool", fields: [approvedSchoolId], references: [id])
  approvedSchoolId          String?

  @@index([createdAt])
  @@index([reviewerId, createdAt])
}

model Instructor {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String          @unique

  assignedCourses           AssignedInstructor[]
  lessonEvaluations         StudentLessonEvaluation[]
  suggestions               InstructorSuggestion[]
  lessonPresences           InstructorLessonPresence[]
}

model Student {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String          @unique

  enrolledCourses           EnrolledStudent[]
  evaluations               StudentLessonEvaluation[]
  meetingAttendances        MeetingAttendance[]
  refundRequests            RefundRequest[]
}

model Syllabus {
  id                        String                  @id @default(uuid())
  createdAt                 DateTime                @default(now())

  name                      String

  school                    School?                 @relation(fields: [schoolId], references: [id])
  schoolId                  String?

  versions                  SyllabusVersion[]
  prerequisites             SyllabusPrerequisite[]  @relation("RequiresSyllabus")
  prerequisiteFor           SyllabusPrerequisite[]  @relation("IsPrerequisiteFor")

  @@unique([schoolId, name])
}

model SyllabusPrerequisite {
  syllabus              Syllabus @relation("RequiresSyllabus", fields: [syllabusId], references: [id], onDelete: Cascade)
  syllabusId            String
  
  requiredSyllabus      Syllabus @relation("IsPrerequisiteFor", fields: [requiredSyllabusId], references: [id])
  requiredSyllabusId    String
  
  isForInstructor       Boolean  // true = instructor requirement, false = student prerequisite
  
  @@id([syllabusId, requiredSyllabusId, isForInstructor])
  @@index([syllabusId, isForInstructor])
}

model CourseInterest {
  id                        String                @id @default(uuid())
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  course                    Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                  String

  user                      User                  @relation(fields: [userId], references: [id])
  userId                    String

  status                    CourseInterestStatus   @default(INTERESTED)
  notes                     String?

  @@unique([courseId, userId])
  @@index([courseId, status])
  @@index([userId, status])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Account {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  // System accounts reference the special system school (seeded with known ID)
  // School accounts reference the actual flight school
  school                    School          @relation(fields: [schoolId], references: [id])
  schoolId                  String

  currency                  String          // ISO 4217: EUR for system, school.currency for school accounts
  balanceMinor              Int             @default(0)  // Current balance in minor units

  transactions              Transaction[]

  @@unique([userId, schoolId])  // One account per user per school (including system)
  @@index([userId])
  @@index([schoolId])
}

model Transaction {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  account                   Account         @relation(fields: [accountId], references: [id])
  accountId                 String

  type                      TransactionType
  amountMinor               Int             // Always positive; type determines debit/credit
  currency                  String          // Currency at time of transaction (for audit)

  // Link to counterpart transaction (e.g., student withdrawal ↔ school deposit)
  linkedTransaction         Transaction?    @relation("LinkedPair", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedTransactionId       String?
  linkedFromThis            Transaction[]   @relation("LinkedPair")

  description               String?         // e.g., "Charged for PPL Course", "Refund for cancelled lesson", "Trip rental: Cessna 172"
  notes                     String?         // Additional internal notes

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

model SyllabusVersion {
  id                        String                @id @default(uuid())
  createdAt                 DateTime              @default(now())

  syllabus                  Syllabus              @relation(fields: [syllabusId], references: [id])
  syllabusId                String

  version                   Int
  status                    SyllabusVersionStatus @default(DRAFT)

  previousVersion           SyllabusVersion?      @relation("SyllabusVersionHistory", fields: [previousVersionId], references: [id])
  previousVersionId         String?
  nextVersions              SyllabusVersion[]     @relation("SyllabusVersionHistory")

  lessons                   SyllabusLesson[]
  courses                   Course[]
  hiddenDrafts              HiddenSyllabusDraft[]

  @@unique([syllabusId, version])
  @@index([syllabusId, status])
}

model HiddenSyllabusDraft {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  deletedBy                 User            @relation("HiddenSyllabusDraftDeletedBy", fields: [deletedByUserId], references: [id])
  deletedByUserId           String

  syllabusVersion           SyllabusVersion @relation(fields: [syllabusVersionId], references: [id])
  syllabusVersionId         String

  @@unique([deletedByUserId, syllabusVersionId])
  @@index([deletedByUserId, createdAt])
}

model SyllabusLesson {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  syllabusVersion           SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  syllabusVersionId         String

  position                  Int
  name                      String
  description               String
  durationMinutes           Int

  courseLessons             CourseLesson[]

  @@unique([syllabusVersionId, position])
}

model Course {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  syllabusVersion           SyllabusVersion @relation(fields: [syllabusVersionId], references: [id])
  syllabusVersionId         String

  school                    School          @relation(fields: [schoolId], references: [id])
  schoolId                  String

  startDate                 DateTime?
  minCapacity               Int?
  maxCapacity               Int?
  hourlyRate                Int             // Required course hourly rate in whole currency units

  courseInterests           CourseInterest[]
  courseLessons             CourseLesson[]
  assignedInstructors       AssignedInstructor[]
  enrolledStudents          EnrolledStudent[]
  lifecycleEvents           CourseLifecycleEvent[]
  refundRequests            RefundRequest[]

  @@index([startDate])
  @@index([syllabusVersionId, startDate])
  @@index([schoolId])
}

model CourseLesson {
  id                        String              @id @default(uuid())
  createdAt                 DateTime            @default(now())

  course                    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                  String

  syllabusLesson            SyllabusLesson      @relation(fields: [syllabusLessonId], references: [id])
  syllabusLessonId          String

  // Optional metadata for additional sessions on the same syllabus topic.
  // isExtra is a legacy field with no defined creation path; not used in new code.
  isExtra                   Boolean             @default(false)

  location                  String
  date                      DateTime
  bufferMinutes             Int                 @default(30)
  lessonPrice               Int?                // Legacy override field; new code uses course.hourlyRate

  status                    CourseLessonStatus

  proposedBy                User?               @relation("CourseLessonProposedBy", fields: [proposedById], references: [id])
  proposedById              String?

  studentEvaluations        StudentLessonEvaluation[]
  meetingAttendances        MeetingAttendance[]
  instructorSuggestions     InstructorSuggestion[]
  instructorPresences       InstructorLessonPresence[]

  @@index([date])
  @@index([courseId, date])
  @@index([courseId, syllabusLessonId])
  @@index([courseId, status])
}

model AssignedInstructor {
  course                    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                  String

  instructor                Instructor      @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  instructorId              String

  isLead                    Boolean         @default(false)
  agreedWagePerHour         Int?

  @@id([courseId, instructorId])
}

model EnrolledStudent {
  course                    Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                  String

  student                   Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId                 String

  status                    EnrolledStudentStatus @default(ACTIVE)

  @@id([courseId, studentId])
  @@index([courseId, status])
}

model StudentLessonEvaluation {
  id                        String                @id @default(uuid())
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  student                   Student               @relation(fields: [studentId], references: [id])
  studentId                 String

  courseLesson              CourseLesson          @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  courseLessonId            String

  instructor                Instructor            @relation(fields: [instructorId], references: [id])
  instructorId              String

  notes                     String?
  status                    LessonEvaluationStatus
  attended                  Boolean                @default(true)

  @@unique([studentId, courseLessonId])
  @@index([instructorId])
  @@index([status])
}

model CourseLifecycleEvent {
  id                        String                 @id @default(uuid())
  createdAt                 DateTime               @default(now())

  course                    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                  String

  changedBy                 User                   @relation("CourseLifecycleChangedBy", fields: [changedByUserId], references: [id])
  changedByUserId           String

  status                    CourseLifecycleStatus

  @@index([courseId, createdAt])
  @@index([changedByUserId, createdAt])
}

model MeetingAttendance {
  id              String                 @id @default(uuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  courseLesson    CourseLesson           @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  courseLessonId  String

  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId       String

  status          MeetingAttendanceStatus @default(NO_RESPONSE)

  @@unique([studentId, courseLessonId])
  @@index([courseLessonId, status])
  @@index([studentId])
}

model InstructorSuggestion {
  id                      String                    @id @default(uuid())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  courseLesson            CourseLesson              @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  courseLessonId          String

  proposedByInstructor    Instructor                @relation(fields: [proposedByInstructorId], references: [id])
  proposedByInstructorId  String

  type                    InstructorSuggestionType
  status                  InstructorSuggestionStatus @default(PENDING)

  reviewedBy              User?                     @relation("InstructorSuggestionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedByUserId        String?
  reviewedAt              DateTime?

  @@index([courseLessonId])
}

model InstructorLessonPresence {
  id              String                          @id @default(uuid())
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  courseLesson    CourseLesson                    @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  courseLessonId  String

  instructor      Instructor                      @relation(fields: [instructorId], references: [id])
  instructorId    String

  status          InstructorLessonPresenceStatus  @default(EXPECTED)

  @@unique([instructorId, courseLessonId])
  @@index([courseLessonId])
}

model RefundRequest {
  id                      String               @id @default(uuid())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  course                  Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId                String

  student                 Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId               String

  status                  RefundRequestStatus  @default(PENDING)
  approvedAmountMinor     Int?
  reason                  String?

  reviewedBy              User?                @relation("RefundRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedByUserId        String?
  reviewedAt              DateTime?

  @@index([courseId, studentId, status])
  @@index([studentId])
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model AuditLog {
  id                       String          @id @default(uuid())
  createdAt                DateTime        @default(now())

  entityType               String
  entityId                 String

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}
