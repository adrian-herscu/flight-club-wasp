{
  "name": "opensaas",
  "type": "module",
  "scripts": {
    "git:clean": "git clean -fdX",
    "lint:ui-boundary": "node scripts/enforce-ui-boundary.mjs",

    "wasp:kill": "fuser -k 3000/tcp 3001/tcp || true",
    "wasp:clean": "rm -rf .wasp",
    "wasp:db:reset": "wasp db reset --force",
    "db:reset": "npx prisma migrate reset --force --skip-generate --schema schema.prisma",

    "wasp:lint": "npm run lint:ui-boundary",
    "wasp:build": "wasp build",
  
    "wasp:start": "wasp start",
    "wasp:start:bg": "node scripts/start-wasp-bg.mjs",
    "wasp:restart": "npm run wasp:kill && npm run wasp:clean && npm run wasp:lint && npm run wasp:db:reset && npm run wasp:start:bg",
    "scaffold:dashboard-page": "node scripts/scaffold-dashboard-page.mjs",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reportsDirectory=out/coverage",

    "e2e:regression": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "e2e:smoke": "PLAYWRIGHT_HTML_REPORT=out/playwright-report npx playwright test --config=tests/e2e/playwright.config.ts --project=chromium --grep @smoke --reporter=html,github",
    "e2e:regression:ui": "npx playwright test --config=tests/e2e/playwright.config.ts --ui"
},
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.523.0",
    "@aws-sdk/s3-presigned-post": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.523.0",
    "@google-analytics/data": "4.1.0",
    "@hookform/resolvers": "^5.1.1",
    "@lemonsqueezy/lemonsqueezy.js": "^3.2.0",
    "@polar-sh/sdk": "^0.34.3",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@sendgrid/mail": "^8.1.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "apexcharts": "3.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^23.7.6",
    "lucide-react": "^0.525.0",
    "openai": "^4.55.3",
    "prettier": "3.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.1",
    "react-apexcharts": "1.4.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^14.1.0",
    "react-router": "^7.12.0",
    "stripe": "18.1.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vanilla-cookieconsent": "^3.0.1",
    "zod": "^3.25.76",
    "@prisma/client": "5.19.1"
  },
  "devDependencies": {
    "@faker-js/faker": "8.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/react": "^19.2.7",
    "prisma": "5.19.1",
    "typescript": "5.8.2",
    "vite": "^7.0.6",
    "@playwright/test": "^1.42.1",
    "@prisma/client": "5.19.1",
    "@types/node": "^22.0.0",
    "vitest": "^2.0.0",
    "dotenv": "^16.6.1"
  },
  "prisma": {
    "schema": "schema.prisma"
  }
}
