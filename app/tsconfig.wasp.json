{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "NodeNext",
    "noEmit": true,
    "lib": ["ES2023"],
    "baseUrl": ".",
    "paths": {
      "wasp-config": [".wasp/out/sdk/wasp/wasp-config.js"]
    }
  },
  "include": ["main.wasp.ts", ".wasp/out/sdk/wasp/**/*"]
}
