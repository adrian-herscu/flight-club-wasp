    %% ──────────────────────────────────────────────
    %% NAVIGATION EDGES
    %% ──────────────────────────────────────────────

    %% Public navigation
    LANDING -->|"NavBar · [Login]"| LOGIN
    LANDING -->|"NavBar · [Sign Up]"| SIGNUP
    LOGIN   -->|"[Sign Up] link"| SIGNUP
    LOGIN   -->|"[Forgot password?] link"| REQ_RESET
    SIGNUP  -->|"[Create account] success"| VERIFY
    VERIFY  -->|"Code verified"| LOGIN
    REQ_RESET -->|"Email sent → link clicked"| RESET
    RESET   -->|"[Reset Password] success"| LOGIN

    %% Auth success → role gate
    LOGIN   -->|"[Sign In] success"| ROLE_GATE

    %% Role gate routing
    ROLE_GATE -->|"role = USER"| REG
    ROLE_GATE -->|"role ≠ USER"| DASH

    %% Registration flow
    REG         -->|"[Submit Request]"| REG_PENDING
    REG_PENDING -->|"Approved: role upgraded → refresh"| DASH

    %% Admin sidebar – all authenticated roles
    DASH <-->|"Sidebar"| USERS
    DASH <-->|"Sidebar"| CALENDAR
    DASH <-->|"Sidebar"| SETTINGS
    DASH <-->|"Sidebar"| MESSAGES
    DASH <-->|"Sidebar · UI Elements"| UI_BTN
    DASH <-->|"Header avatar"| ACCOUNT

    %% Admin sidebar – SYSTEM_ADMIN extras
    DASH <-->|"Sidebar [SYSTEM_ADMIN]"| SCH_REQ
    DASH <-->|"Sidebar [SYSTEM_ADMIN]"| SYLLABUSES

    %% Admin sidebar – SCHOOL_MANAGER extras
    DASH <-->|"Sidebar [SCHOOL_MANAGER]"| MBR_REQ
    DASH <-->|"Sidebar [SCHOOL_MANAGER]"| MY_SCHOOL
    DASH <-->|"Sidebar [SCHOOL_MANAGER]"| SYLLABUSES

    %% In-page actions (self-loops = stays on same page after action)
    SCH_REQ -->|"[Approve] → toast + list refresh"| SCH_REQ
    SCH_REQ -->|"[Reject] → toast + list refresh"| SCH_REQ
    MBR_REQ -->|"[Approve] → toast + list refresh"| MBR_REQ
    MBR_REQ -->|"[Reject] → toast + list refresh"| MBR_REQ
    MY_SCHOOL -->|"[Save] → toast + data refresh"| MY_SCHOOL
    SYLLABUSES -->|"[Save draft] / [Publish] → toast"| SYLLABUSES

    %% Catch-all
    NOT_FOUND -.->|"[Go home]"| LANDING

    %% ──────────────────────────────────────────────
    %% VISUAL GROUPING
    %% ──────────────────────────────────────────────

