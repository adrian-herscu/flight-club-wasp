%% Flight Club – Site Navigation & GUI Wireframe
%% Simplified view: public flow + registration + separate admin sections per role

flowchart TD

    LANDING["/** Landing Page<br/>Menu: Login, Sign Up<br/>Content: marketing shell, currently empty"]
    LOGIN["/login Login<br/>Fields: email, password<br/>Actions: Sign In, Google sign-in<br/>Links: Sign Up, Forgot password"]
    SIGNUP["/signup Sign Up<br/>Fields: email, password<br/>Action: Create account<br/>Link: Log In"]
    VERIFY["/email-verification Verify Email<br/>Field: verification code<br/>Action: Verify"]
    REQ_RESET["/request-password-reset Forgot Password<br/>Field: email<br/>Action: Send reset link"]
    RESET["/password-reset Reset Password<br/>Fields: new password, confirm password<br/>Action: Reset Password"]
    ROLE_GATE{{"Post-login role check<br/>USER → /registration<br/>All other roles → /admin"}}

    REG["/registration Registration Request<br/>Fields: full name, phone, requested role<br/>Manager flow: school details form<br/>Instructor/Student flow: school selector<br/>Action: Submit Request"]
    REG_PENDING["Registration Pending<br/>Read-only submitted details<br/>Status: PENDING"]

    AUTH_DASH["/admin Dashboard<br/>Menu: sidebar by role<br/>Content: under construction"]
    AUTH_USERS["/admin/users Users<br/>Menu: Dashboard, Users, Calendar, UI Buttons<br/>Info: paginated users, role/admin toggle"]
    AUTH_CALENDAR["/admin/calendar Calendar<br/>Menu: shared sidebar items<br/>Info: calendar component"]
    AUTH_MESSAGES["/admin/messages Messages<br/>Menu: shared sidebar items<br/>Info: contact form messages"]
    AUTH_SETTINGS["/admin/settings Settings<br/>Menu: shared sidebar items<br/>Info: stub settings page"]
    AUTH_UI["/admin/ui/buttons UI Buttons<br/>Menu: UI Elements > Buttons<br/>Info: button showcase"]
    ACCOUNT["/account Account<br/>Access: header/avatar menu<br/>Info: email, full name, about"]

    SYS_DASH["SYSTEM_ADMIN Admin Home<br/>Menu: Dashboard, Users, School Requests, Syllabuses, Calendar, UI Buttons"]
    SCH_REQ["/admin/school-requests School Requests<br/>Info: pending school-manager requests<br/>Fields per card: requester, school details, rejection reason<br/>Actions: Approve, Reject"]
    SYS_SYLLABUSES["/admin/syllabuses Syllabuses<br/>Info: catalog, drafts, course opening, enrollment tools<br/>Actions: create draft, publish, create course"]

    MGR_DASH["SCHOOL_MANAGER Admin Home<br/>Menu: Dashboard, Users, Member Requests, My School, Syllabuses, Calendar, UI Buttons"]
    MBR_REQ["/admin/member-requests Member Requests<br/>Info: pending instructor/student requests<br/>Fields per card: requester, role, school, rejection reason<br/>Actions: Approve, Reject"]
    MY_SCHOOL["/admin/school My School<br/>Fields: school name, website, address, city, state, postal code<br/>Info: account balances (read-only)<br/>Action: Save"]
    MGR_SYLLABUSES["/admin/syllabuses Syllabuses<br/>Info: catalog, draft editor, courses, enrollment, instructor assignment<br/>Actions: save draft, publish, enroll, assign"]

    BASIC_DASH["INSTRUCTOR / STUDENT Admin Home<br/>Menu: Dashboard, Users, Calendar, UI Buttons<br/>Info: no dedicated workflow pages yet"]

    NOT_FOUND["* Not Found<br/>Info: missing route page<br/>Action: return home"]

