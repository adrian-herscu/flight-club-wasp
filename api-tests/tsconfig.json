{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      // Mirror the vitest.config.ts alias so tsc type-checks correctly
      "wasp/server": ["./src/wasp-server-stub.ts"]
    }
  },
  "include": [
    "src",
    "tests",
    "global-setup.ts",
    // Include app source so operation files type-check without copying them
    "../app/src"
  ]
}
