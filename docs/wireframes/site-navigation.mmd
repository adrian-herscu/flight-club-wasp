%% Flight Club - Site Navigation Wireframe
%% Reflects current route structure in main.wasp.

flowchart TD

    LANDING["/ Landing"]
    LOGIN["/login"]
    SIGNUP["/signup"]
    VERIFY["/email-verification"]
    REQ_RESET["/request-password-reset"]
    RESET["/password-reset"]
    REG["/registration"]
    ACCOUNT["/account"]
    NOT_FOUND["* -> 404"]

    ROLE_GATE{{"Post-login role routing"}}

    subgraph SYSTEM_ADMIN["SYSTEM_ADMIN (/system-admin)"]
        direction TB
        SA_HOME["/system-admin Dashboard"]
        SA_USERS["/system-admin/users"]
        SA_SCHOOL_REQ["/system-admin/school-requests"]
        SA_SYL["/system-admin/syllabuses?section=..."]
        SA_SETTINGS["/system-admin/settings"]
        SA_MESSAGES["/system-admin/messages"]
    end

    subgraph SCHOOL_MANAGER["SCHOOL_MANAGER (/school-manager)"]
        direction TB
        SM_HOME["/school-manager Dashboard"]
        SM_REQ_I["/school-manager/member-requests/instructors"]
        SM_REQ_S["/school-manager/member-requests/students"]
        SM_SCHOOL["/school-manager/school"]
        SM_COURSES["/school-manager/courses"]
        SM_COURSE_DETAIL["/school-manager/courses/:courseId"]
        SM_SYL["/school-manager/syllabuses?section=..."]
    end

    subgraph INSTRUCTOR["INSTRUCTOR (/instructor)"]
        direction TB
        I_HOME["/instructor Dashboard"]
        I_COURSES["/instructor/courses"]
        I_COURSE_DETAIL["/instructor/courses/:courseId"]
    end

    subgraph STUDENT["STUDENT (/student)"]
        direction TB
        ST_HOME["/student Dashboard"]
        ST_COURSES["/student/courses"]
        ST_COURSE_DETAIL["/student/courses/:courseId"]
    end

    LANDING --> LOGIN
    LANDING --> SIGNUP
    LOGIN --> REQ_RESET
    SIGNUP --> VERIFY
    VERIFY --> LOGIN
    REQ_RESET --> RESET
    RESET --> LOGIN
    LOGIN --> ROLE_GATE

    ROLE_GATE -->|USER pending role| REG
    ROLE_GATE -->|SYSTEM_ADMIN| SA_HOME
    ROLE_GATE -->|SCHOOL_MANAGER| SM_HOME
    ROLE_GATE -->|INSTRUCTOR| I_HOME
    ROLE_GATE -->|STUDENT| ST_HOME

    SA_HOME --> SA_USERS
    SA_HOME --> SA_SCHOOL_REQ
    SA_HOME --> SA_SYL
    SA_HOME --> SA_SETTINGS
    SA_HOME --> SA_MESSAGES

    SM_HOME --> SM_REQ_I
    SM_HOME --> SM_REQ_S
    SM_HOME --> SM_SCHOOL
    SM_HOME --> SM_COURSES
    SM_COURSES --> SM_COURSE_DETAIL
    SM_HOME --> SM_SYL

    I_HOME --> I_COURSES
    I_COURSES --> I_COURSE_DETAIL

    ST_HOME --> ST_COURSES
    ST_COURSES --> ST_COURSE_DETAIL

    SA_HOME --> ACCOUNT
    SM_HOME --> ACCOUNT
    I_HOME --> ACCOUNT
    ST_HOME --> ACCOUNT

    NOT_FOUND -.-> LANDING
