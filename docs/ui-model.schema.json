{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./ui-model.schema.json",
  "title": "Flight Club UI Model",
  "type": "object",
  "required": ["roles", "data_flows"],
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "data_flows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/dataFlow" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrScalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pageRef": {
      "type": "string",
      "minLength": 1,
      "description": "A menu item token: usually a page name declared in the role's pages map, or a non-navigation action token such as action:logout."
    },
    "operationList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        ]
      }
    },
    "dataBinding": {
      "type": "object",
      "required": ["source_operation"],
      "additionalProperties": false,
      "properties": {
        "source_operation": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "$ref": "#/$defs/nonEmptyString" },
        "entity": { "$ref": "#/$defs/nonEmptyString" },
        "nested_entities": { "$ref": "#/$defs/stringList" },
        "filter": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dataGroup": {
      "type": "object",
      "required": ["source_operation", "filter", "fields"],
      "additionalProperties": false,
      "properties": {
        "source_operation": { "$ref": "#/$defs/nonEmptyString" },
        "filter": { "$ref": "#/$defs/nonEmptyString" },
        "fields": { "$ref": "#/$defs/stringList" }
      }
    },
    "fieldSpec": {
      "type": "object",
      "required": ["type", "operation_param"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "operation_param": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Explicit payload parameter name for the target write operation."
        },
        "constraints": { "$ref": "#/$defs/stringList" },
        "source": {
          "type": "object",
          "required": ["operation", "value", "label"],
          "additionalProperties": false,
          "properties": {
            "operation": { "$ref": "#/$defs/nonEmptyString" },
            "value": { "$ref": "#/$defs/nonEmptyString" },
            "label": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "schema_model": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "pageLink": {
      "type": "object",
      "required": ["target", "relation"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "relation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "interactionFlow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submit": {
          "type": "object",
          "required": ["intent", "operation"],
          "additionalProperties": false,
          "properties": {
            "intent": { "$ref": "#/$defs/nonEmptyString" },
            "operation": { "$ref": "#/$defs/nonEmptyString" },
            "payload": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/stringOrScalar" }
            }
          }
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fieldSpec" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "path_params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "read_operations": { "$ref": "#/$defs/operationList" },
        "write_operations": { "$ref": "#/$defs/operationList" },
        "data_bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/dataBinding" }
        },
        "bound_fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fieldSpec" }
        },
        "derived_fields": { "$ref": "#/$defs/stringList" },
        "page_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/pageLink" }
        },
        "data_groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/dataGroup" }
        },
        "interaction_flows": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/interactionFlow" }
        }
      }
    },
    "role": {
      "type": "object",
      "required": ["description", "pages"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "extends": { "$ref": "#/$defs/nonEmptyString" },
        "menu": {
          "type": "array",
          "items": { "$ref": "#/$defs/pageRef" }
        },
        "pages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/page" }
        }
      }
    },
    "dataFlowStep": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/stringOrScalar" },
      "properties": {
        "page": { "$ref": "#/$defs/nonEmptyString" },
        "query": { "$ref": "#/$defs/nonEmptyString" },
        "queries": { "$ref": "#/$defs/stringList" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "result": { "$ref": "#/$defs/nonEmptyString" },
        "effect": { "$ref": "#/$defs/nonEmptyString" },
        "guard": { "$ref": "#/$defs/nonEmptyString" },
        "async": { "$ref": "#/$defs/nonEmptyString" },
        "background_job": { "$ref": "#/$defs/nonEmptyString" },
        "manager": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "dataFlow": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nonEmptyString" },
              { "$ref": "#/$defs/dataFlowStep" }
            ]
          }
        }
      }
    }
  }
}
